<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Dashboard - Placement Tracker</title>

    <!-- Tailwind -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <style>
      body {
        font-family: "Poppins", sans-serif;
      }
    </style>
  </head>

  <body class="bg-[#f6f7fb]">
    <div class="flex min-h-screen">
      <!-- Sidebar -->
      <aside class="w-72 bg-white border-r border-gray-100 p-6 hidden md:block">
        <!-- Logo -->
        <div class="flex items-center gap-3 mb-12">
          <div
            class="w-12 h-12 rounded-2xl bg-violet-600 flex items-center justify-center text-white font-bold"
          >
            PT
          </div>

          <div>
            <h1 class="font-semibold text-lg">Placement Tracker</h1>
          </div>
        </div>

        <!-- Menu -->
        <nav class="space-y-3">
          <!-- Active -->
          <a
            href="/dashboard"
            class="flex items-center gap-3 px-4 py-3 rounded-2xl  bg-violet-50 text-violet-700 font-medium  "
          >
            📊 Dashboard
          </a>

          <a
            href="/application"
            class="flex items-center gap-3 px-4 py-3 rounded-2xl text-gray-600 hover:bg-gray-50 transition"
          >
            📌 Applications
          </a>
          <a
            href="/opportunities"
            class="flex items-center gap-3 px-4 py-3 rounded-2xl text-gray-600 hover:bg-gray-50 transition"
          >
            🏢 opportunities
          </a>

          <a
            href="/resume"
            class="flex items-center gap-3 px-4 py-3 rounded-2xl text-gray-600 hover:bg-gray-50 transition"
          >
            📄 Resume Analyzer
          </a>

          
          <a
            href="/profile"
            class="flex items-center gap-3 px-4 py-3 rounded-2xl text-gray-600 hover:bg-gray-50 transition"
          >
            👤 Profile
          </a>
          <div
            class="hover:bg-gray-50 px-4 py-3 rounded-2xl flex items-center gap-3 text-gray-600 cursor-pointer transition"
          >
            ⚙️ Settings
          </div>
        </nav>
      </aside>

      <!-- Main Content -->
      <main class="flex-1 p-8">
        <!-- Topbar -->
        <div class="flex items-center justify-between mb-10">
          <!-- Left -->
          <div>
            <h1 class="text-3xl font-bold text-gray-800">
              Welcome Back, <%= user.name %> 👋
            </h1>

            <p class="text-gray-500 mt-1">
              Track your placement journey smarter.
            </p>
          </div>

          <!-- Right -->
          <div class="flex items-center gap-5">
            <button
              class="w-11 h-11 rounded-2xl bg-white shadow-sm flex items-center justify-center"
            >
              🔔
            </button>

            <div
              class="flex items-center gap-3 bg-white px-4 py-2 rounded-2xl shadow-sm"
            >
              <img
                src="<%= user.image %>"
                class="w-10 h-10 rounded-full"
              />

              <div>
                <h3 class="font-medium text-sm"><%= user.name %></h3>

                <p class="text-xs text-gray-500">Student</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Stats -->
        <div class="grid md:grid-cols-4 gap-6 mb-8">
          <!-- Card -->
          <div class="bg-white p-6 rounded-3xl shadow-sm">
            <div class="flex items-center justify-between mb-4">
              <div
                class="w-14 h-14 rounded-2xl bg-violet-100 flex items-center justify-center text-2xl"
              >
                📄
              </div>

              <span class="text-green-500 text-sm font-medium"> +12% </span>
            </div>

            <h2 id="totalApplications" class="text-3xl font-bold text-gray-800">
              0
            </h2>

            <p class="text-gray-500 mt-1">Applications</p>
          </div>

          <!-- Card -->
          <div class="bg-white p-6 rounded-3xl shadow-sm">
            <div class="flex items-center justify-between mb-4">
              <div
                class="w-14 h-14 rounded-2xl bg-blue-100 flex items-center justify-center text-2xl"
              >
                💼
              </div>

              <span class="text-green-500 text-sm font-medium"> +8% </span>
            </div>

            <h2 id="totalInterviews" class="text-3xl font-bold text-gray-800">
              0
            </h2>

            <p class="text-gray-500 mt-1">Interviews</p>
          </div>

          <!-- Card -->
          <div class="bg-white p-6 rounded-3xl shadow-sm">
            <div class="flex items-center justify-between mb-4">
              <div
                class="w-14 h-14 rounded-2xl bg-orange-100 flex items-center justify-center text-2xl"
              >
                🏆
              </div>

              <span class="text-green-500 text-sm font-medium"> +4% </span>
            </div>

            <h2 id="totalSelected" class="text-3xl font-bold text-gray-800">
              0
            </h2>

            <p class="text-gray-500 mt-1">Offers</p>
          </div>

          <!-- Card -->
          <div class="bg-white p-6 rounded-3xl shadow-sm">
            <div class="flex items-center justify-between mb-4">
              <div
                class="w-14 h-14 rounded-2xl bg-pink-100 flex items-center justify-center text-2xl"
              >
                🤖
              </div>

              <span class="text-violet-600 text-sm font-medium"> 78% </span>
            </div>

            <h2 class="text-3xl font-bold text-gray-800">Strong</h2>

            <p class="text-gray-500 mt-1">Profile Score</p>
          </div>
        </div>

        <!-- Bottom Grid -->
        <div class="grid lg:grid-cols-3 gap-6">
          <!-- Left -->
          <div class="lg:col-span-2 space-y-6">
            <!-- Application Status -->
            <div class="bg-white rounded-3xl p-6 shadow-sm">
              <div class="flex items-center justify-between mb-6">
                <h2 class="text-xl font-semibold">Recent Applications</h2>

                <button class="text-violet-600 text-sm font-medium">
                  View All
                </button>
              </div>

              <!-- Table -->
              <div class="overflow-x-auto">
                <table class="w-full">
                  <thead>
                    <tr class="text-left text-gray-400 text-sm border-b">
                      <th class="pb-4">Company</th>
                      <th class="pb-4">Role</th>
                      <th class="pb-4">Date</th>
                      <th class="pb-4">Status</th>
                      <th class="pb-4">Package</th>
                    </tr>
                  </thead>

                  <tbody id="applicationTableBody" class="text-gray-700">
                  </tbody>
                </table>
              </div>
            </div>

            <!-- Progress -->
            <div class="bg-white rounded-3xl p-6 shadow-sm">
              <div class="flex items-center justify-between mb-6">
                <h2 class="text-xl font-semibold">Placement Progress</h2>

                <span class="text-violet-600 font-semibold"> 78% </span>
              </div>

              <!-- Progress -->
              <div class="w-full h-4 bg-gray-100 rounded-full overflow-hidden">
                <div
                  class="h-full bg-gradient-to-r from-violet-600 to-indigo-600 w-[78%] rounded-full"
                ></div>
              </div>

              <!-- Labels -->
              <div class="flex justify-between mt-4 text-sm text-gray-500">
                <span>Beginner</span>
                <span>Intermediate</span>
                <span>Placement Ready</span>
              </div>
            </div>
          </div>

          <!-- Right -->
          <div class="space-y-6">
            <!-- AI Suggestions -->
            <div
              class="bg-gradient-to-br from-violet-600 to-indigo-600 rounded-3xl p-6 text-white shadow-lg"
            >
              <div class="text-4xl mb-5">🤖</div>

              <h2 class="text-2xl font-semibold mb-3">AI Suggestions</h2>

              <p class="text-violet-100 leading-relaxed mb-6">
                Improve your DSA and React skills to increase placement chances.
              </p>

              <button
                class="bg-white text-violet-700 px-5 py-3 rounded-2xl font-medium hover:bg-gray-100 transition"
              >
                Analyze Resume
              </button>
            </div>

            <!-- Upcoming Interview -->
            <div class="bg-white rounded-3xl p-6 shadow-sm">
              <div class="flex items-center justify-between mb-5">
                <h2 class="text-xl font-semibold">Upcoming</h2>

                <span class="text-sm text-violet-600"> 2 Interviews </span>
              </div>

              <!-- Card -->
              <div class="bg-violet-50 rounded-2xl p-5 mb-4">
                <h3 class="font-semibold mb-1">Infosys</h3>

                <p class="text-sm text-gray-600">Technical Interview</p>

                <p class="text-sm text-violet-600 mt-3">Tomorrow • 10:00 AM</p>
              </div>

              <!-- Card -->
              <div class="bg-blue-50 rounded-2xl p-5">
                <h3 class="font-semibold mb-1">Deloitte</h3>

                <p class="text-sm text-gray-600">HR Round</p>

                <p class="text-sm text-blue-600 mt-3">Friday • 2:00 PM</p>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>
    <script src="/javascripts/script.js"></script>
  </body>
</html>
