<!DOCTYPE html>
<html lang="en">
<head>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Placement Tracker</title>

  <!-- Tailwind -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Font -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <!-- CSS -->
  <link rel="stylesheet" href="/css/style.css">

</head>

<body class="bg-[#f7f7ff]">

  <!-- Navbar -->
  <nav class="bg-white px-10 py-5 flex items-center justify-between shadow-sm">

    <div class="flex items-center gap-3">

      <div class="w-11 h-11 rounded-2xl bg-violet-600 text-white flex items-center justify-center font-bold">
        PT
      </div>

      <h1 class="text-xl font-semibold">
        Placement Tracker
      </h1>

    </div>

    <a
      href="/login"
      class="bg-violet-600 hover:bg-violet-700 transition text-white px-6 py-3 rounded-2xl"
    >
      Login
    </a>

  </nav>

  <!-- Hero -->
  <section class="min-h-[85vh] flex items-center px-10">

    <div class="grid md:grid-cols-2 gap-16 items-center w-full">

      <!-- Left -->
      <div>

        <p class="text-violet-600 font-medium mb-4">
          AI-Powered Platform
        </p>

        <h1 class="text-6xl font-bold leading-tight text-gray-800 mb-6">

          Track Your <br>
          Placement Journey 🚀

        </h1>

        <p class="text-gray-500 text-lg leading-relaxed mb-8">

          Manage applications, analyze resumes and improve your placement preparation with AI-powered insights.

        </p>

        <div class="flex gap-5">

          <a
            href="/dashboard"
            class="bg-violet-600 hover:bg-violet-700 transition text-white px-7 py-4 rounded-2xl shadow-lg"
          >
            Get Started
          </a>

          <button class="border border-violet-200 hover:bg-violet-50 transition px-7 py-4 rounded-2xl">
            Learn More
          </button>

        </div>
  </section>
<script src="/javascripts/script.js"></script>
</body>
</html>