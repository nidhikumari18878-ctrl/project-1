<!DOCTYPE html>
<html lang="en">
<head>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Placement Tracker</title>

  <!-- Tailwind -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Font -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <!-- CSS -->
  <link rel="stylesheet" href="/css/style.css">

</head>

<body class="bg-black text-white">
  <div class="fixed top-0 left-0 w-96 h-96 bg-violet-600/20 blur-[120px] rounded-full"></div>

<div class="fixed bottom-0 right-0 w-96 h-96 bg-fuchsia-600/20 blur-[120px] rounded-full"></div>

  <!-- Navbar -->
  <nav class="bg-zinc-900/80 backdrop-blur-xl border-b border-zinc-800 px-10 py-5 flex items-center justify-between ">

    <div class="flex items-center gap-3">

      <div class="w-11 h-11 rounded-2xl bg-gradient-to-r from-violet-600 to-fuchsia-600 text-white flex items-center justify-center font-bold shadow-lg">
        PT
      </div>

      <h1 class="text-xl font-bold text-white">
        Placement Tracker
      </h1>

    </div>

    <a
      href="/login"
      class="bg-gradient-to-r from-violet-600 to-fuchsia-600 hover:scale-105 transition text-white px-6 py-3 rounded-2xl shadow-lg"
    >
      Login
    </a>

  </nav>

  <!-- Hero -->
  <section class="min-h-[90vh] flex items-center px-10 relative overflow-hidden">

    <div class="grid md:grid-cols-2 gap-16 items-center w-full">

      <!-- Left -->
      <div>

        <p class="text-violet-400 font-medium mb-4 uppercase tracking-wider">
          AI-Powered Platform
        </p>

        <h1 class="text-6xl font-bold leading-tight text-white mb-6">

          Track Your <br>
          Placement Journey 🚀

        </h1>

        <p class="text-gray-400 text-lg leading-relaxed mb-8 max-w-xl">

          Manage applications, analyze resumes and improve your placement preparation with AI-powered insights.

        </p>

        <div class="flex gap-5">

          <a
            href="/dashboard"
            class="bg-gradient-to-r from-violet-600 to-fuchsia-600 hover:scale-105 transition text-white px-7 py-4 rounded-2xl shadow-xl"
          >
            Get Started
          </a>

          <button class="border border-zinc-700 hover:bg-violet-500 hover:bg-violet-600/10 transition px-7 py-4 rounded-2xl text-white">
            Learn More
          </button>

        </div>
  </section>
<script src="/javascripts/script.js"></script>
</body>
</html>