<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Profile</title>

  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 flex justify-center items-center min-h-screen">

  <div class="bg-white shadow-2xl rounded-2xl p-8 w-[450px]">

    <!-- Profile Image -->
    <div class="flex justify-center">

      <img 
        src="<%= user.image %>"
        alt="profile"
        class="w-48 h-48 rounded-full object-cover border-4 border-blue-500"
      >

    </div>

    <!-- User Info -->
    <div class="text-center mt-5">

      <h1 class="text-2xl font-bold">
        <%= user.name %>
      </h1>

      <p class="text-gray-500 mt-1">
        <%= user.email %>
      </p>

    </div>

    <!-- Buttons -->
    <div class="mt-8 flex flex-col gap-3">

      <a href="/dashboard"
        class="bg-blue-500 hover:bg-blue-600 text-white text-center py-2 rounded-lg transition">

        Dashboard

      </a>

      <a href="/update-profile"
        class="bg-green-500 hover:bg-green-600 text-white text-center py-2 rounded-lg transition">

        Edit Profile

      </a>

      <a href="/logout"
        class="bg-red-500 hover:bg-red-600 text-white text-center py-2 rounded-lg transition">

        Logout

      </a>

    </div>

  </div>

</body>
</html>