<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <script src="https://cdn.tailwindcss.com"></script>

  <title>Opportunities</title>
</head>

<body class="bg-gray-100 min-h-screen p-8">

  <h1 class="text-4xl font-bold mb-8">
    Opportunities
  </h1>
 <form method="GET" action="/opportunities" class="mb-6 flex gap-3">

  <input
    type="text"
    name="search"
    value="<%= search || '' %>"
    placeholder="Search Company"
    class="border px-4 py-2 rounded-xl"
  >

  <button
    class="bg-violet-600 text-white px-5 py-2 rounded-xl">
    Search
  </button>

</form>
<% opportunities.forEach(item=>{ %>

<div class="bg-white p-6 rounded-3xl shadow">

  <img
    src="<%= item.logo %>"
    class="w-12 h-12 mb-4"
  >

  <h2 class="text-xl font-bold">
    <%= item.companyName %>
  </h2>

  <p>
    <%= item.role %>
  </p>

  <p>
    📍 <%= item.location %>
  </p>

  <p>
    💰 <%= item.stipend %>
  </p>

  <div class="flex gap-2 flex-wrap mt-3">

    <% item.skills.forEach(skill=>{ %>

      <span class="bg-violet-100 px-3 py-1 rounded-full">
        <%= skill %>
      </span>

    <% }) %>

  </div>

  <a
    href="<%= item.applyLink %>"
    target="_blank"
    class="block mt-4 bg-blue-500 text-white text-center py-2 rounded-xl"
  >
    Apply
  </a>

</div>

<% }) %>

  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">

    <% opportunities.forEach(function(item){ %>

      <div class="bg-white rounded-2xl shadow-lg p-6">

        <h2 class="text-2xl font-bold">
          <%= item.companyName %>
        </h2>

        <p class="mt-3">
          Role: <%= item.role %>
        </p>

        <p>
          Type: <%= item.type %>
        </p>

        <p>
          Location: <%= item.location %>
        </p>

        <p>
          Stipend: <%= item.stipend %>
        </p>

        <p>
          Deadline: <%= item.deadline %>
        </p>

        <a
          href="/track/<%= item._id %>"
          target="_blank"
          class="block mt-5 bg-blue-500 hover:bg-blue-600 text-white text-center py-2 rounded-lg">

          Apply Now

        </a>
        <a
          href="/track/<%= item._id %>"
          class="block mt-5 bg-green-500 hover:bg-blue-600 text-white text-center py-2 rounded-lg">

          Track This

        </a>

      </div>

    <% }) %>

  </div>

</body>
</html>