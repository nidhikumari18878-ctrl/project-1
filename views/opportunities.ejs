          <%= item.companyName %>
        </h2>

        <p class=" text-gray-300 mt-3">
          Role: <%= item.role %>
        </p>

        <p>
          Type: <%= item.type %>
        </p>

        <p>
          Location: <%= item.location %>
        </p>

        <p>
          Stipend: <%= item.stipend %>
