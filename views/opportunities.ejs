  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">

    <% opportunities.forEach(function(item){ %>

      <div class="bg-zinc-900/80 backdrop-blur-xl border border-zinc-800 rounded-3xl p-6 hover:border-violet-500 transition">

