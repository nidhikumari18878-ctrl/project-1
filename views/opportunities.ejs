<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <script src="https://cdn.tailwindcss.com"></script>

  <title>Opportunities</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
  body{
    font-family:'Poppins',sans-serif;
  }
</style>
</head>

<body class="bg-black min-h-screen text-white">

  <h1 class="text-3xl font-bold text-white">
    Opportunities
  </h1>
  <p class="text-gray-400 mt-1 mb-8">
  Explore jobs, internships and placement opportunities
</p>
 <form method="GET" action="/opportunities" class="mb-8">

  <div class="bg-zinc-900 border border-zinc-800 px-4 py-3 rounded-2xl flex gap-3 max-w-lg">

    <input
      type="text"
      name="search"
      value="<%= search || '' %>"
      placeholder="Search Company..."
      class="w-full bg-transparent outline-none text-white placeholder-gray-500"
    >

    <button
      class="bg-gradient-to-r from-violet-600 to-fuchsia-600 px-5 py-2 rounded-xl">
      Search
    </button>

  </div>

</form>
