<!DOCTYPE html>
<html lang="en">
<head>

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

  <title>Login - Placement Tracker</title>

  <script src="https://cdn.tailwindcss.com"></script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <style>
    body{
      font-family: 'Poppins', sans-serif;
    }
  </style>

</head>

<body class="bg-black min-h-screen flex items-center justify-center px-4 text-white overflow-hidden">

  <!-- Background Glow -->
  <div class="fixed top-0 left-0 w-96 h-96 bg-violet-600/20 blur-[120px] rounded-full"></div>
  <div class="fixed bottom-0 right-0 w-96 h-96 bg-fuchsia-600/20 blur-[120px] rounded-full"></div>

  <!-- Login Container -->
  <div class="relative z-10 w-full max-w-5xl bg-zinc-900/80 backdrop-blur-xl border border-zinc-800 rounded-3xl shadow-2xl overflow-hidden grid md:grid-cols-2">

    <!-- Left Panel -->
    <div class="hidden md:flex flex-col justify-center p-12 bg-gradient-to-br from-violet-600/20 to-fuchsia-600/20 border-r border-zinc-800">

      <div class="w-16 h-16 rounded-3xl bg-gradient-to-r from-violet-600 to-fuchsia-600 flex items-center justify-center text-white font-bold text-xl mb-8">
        PT
      </div>

      <h1 class="text-5xl font-bold mb-6">
        Welcome Back 👋
      </h1>

      <p class="text-gray-300 text-lg leading-relaxed">
        Continue tracking applications, resume analysis and placement preparation from one dashboard.
      </p>

      <div class="mt-10 space-y-4">

        <!-- <div class="bg-zinc-800/50 border border-zinc-700 p-4 rounded-2xl">
          📌 Track Applications
        </div>

        <div class="bg-zinc-800/50 border border-zinc-700 p-4 rounded-2xl">
          📄 Resume Analysis
        </div>

        <div class="bg-zinc-800/50 border border-zinc-700 p-4 rounded-2xl">
          🎯 Placement Insights
        </div> -->

      </div>

    </div>

    <!-- Right Panel -->
    <div class="p-8 md:p-14 flex flex-col justify-center">

      <!-- Logo -->
      <div class="flex items-center justify-center gap-3 mb-10">

        <div class="w-12 h-12 rounded-2xl bg-gradient-to-r from-violet-600 to-fuchsia-600 text-white flex items-center justify-center font-bold">
          PT
        </div>

        <h1 class="text-2xl font-bold">
          Placement Tracker
        </h1>

      </div>

      <!-- Heading -->
      <div class="mb-8">

        <h2 class="text-4xl font-bold text-white mb-3">
          Login
        </h2>

        <p class="text-gray-400">
          Continue your placement journey
        </p>

      </div>

      <!-- Form -->
      <form action="/login" method="POST" class="space-y-6">

        <!-- Email -->
        <div>

          <label class="block mb-2 text-sm font-medium text-gray-300">
            Email Address
          </label>

          <input
            type="email"
            name="email"
            placeholder="Enter your email"
            class="w-full px-5 py-4 rounded-2xl bg-zinc-950 border border-zinc-700 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-violet-500"
          >

        </div>

        <!-- Password -->
        <div>

          <div class="flex items-center justify-between mb-2">

            <label class="text-sm font-medium text-gray-300">
              Password
            </label>

            <a href="#" class="text-sm text-violet-400 hover:text-violet-300">
              Forgot password?
            </a>

          </div>

          <input
            type="password"
            name="password"
            placeholder="Enter your password"
            class="w-full px-5 py-4 rounded-2xl bg-zinc-950 border border-zinc-700 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-violet-500"
          >

        </div>

        <!-- Login Button -->
        <button
          type="submit"
          class="w-full bg-gradient-to-r from-violet-600 to-fuchsia-600 hover:opacity-90 transition text-white py-4 rounded-2xl font-semibold shadow-lg"
        >
          Login
        </button>

      </form>

      <!-- Divider -->
      <div class="flex items-center gap-4 my-8">

        <div class="flex-1 h-px bg-zinc-700"></div>

        <span class="text-gray-500 text-sm">OR</span>

        <div class="flex-1 h-px bg-zinc-700"></div>

      </div>

      <!-- Google Button -->
      <button
        class="w-full border border-zinc-700 bg-zinc-900 hover:bg-zinc-800 transition py-4 rounded-2xl font-medium"
      >
        Continue with Google
      </button>

      <!-- Signup -->
      <p class="text-center text-gray-400 mt-8">

        Don’t have an account?

        <a href="/register" class="text-violet-400 font-medium hover:text-violet-300">
          Sign Up
        </a>

      </p>

    </div>

  </div>

  <script src="/javascripts/script.js"></script>

</body>
</html>