<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Profile</title>
     <link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
  body{
    font-family:'Poppins',sans-serif;
  }
</style>

    <script src="https://cdn.tailwindcss.com"></script>
  </head>

  <body class="bg-black min-h-screen flex justify-center items-center text-white overflow-hidden">
    <div class="fixed top-0 left-0 w-96 h-96 bg-violet-600/20 blur-[120px] rounded-full"></div>

<div class="fixed bottom-0 right-0 w-96 h-96 bg-fuchsia-600/20 blur-[120px] rounded-full"></div>
    <div class="relative z-10 bg-zinc-900/80 backdrop-blur-xl border border-zinc-800  shadow-2xl rounded-3xl p-8 w-[450px]">
      <h1 class="text-3xl font-bold text-center text-white mb-2">Edit Profile</h1>
<p class="text-center text-gray-400 mb-8">
  Update your profile information
</p>
      <!-- Profile Image -->
      <div class="flex justify-center mb-6">
        <img
          src="https://i.pravatar.cc/150?img=12"
          alt="profile"
          class="w-32 h-32 rounded-full object-cover border-4 border-blue-500 shadow-xl"
        />
      </div>

      <!-- Form -->
      <form action="/update-profile" method="POST" class="flex flex-col gap-4">
        <!-- Name -->
        <div>
          <label class="block mb-1 font-medium text-gray-300"> Name </label>

          <input
            type="text"
            name="name"
            value="<%= user.name %>"
            class="w-full bg-zinc-950 border border-zinc-700 rounded-2xl px-5 py-3 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
        </div>

        <!-- Email -->
        <div>
          <label class="block mb-1 font-medium text-gray-300"> Email </label>

          <input
            type="email"
            name="email"
            value="<%= user.email %>"
            class="w-full bg-zinc-950 border border-zinc-700 border border-zinc-700 text-white rounded-2xl px-5 py-3 outline-none focus:ring-2 focus:ring-blue-500"
          />
        </div>

        <!-- Profile Photo URL -->
        <div>
          <label class="block mb-1 font-medium text-gray-300"> Profile Image URL </label>

          <input
            type="text"
            name="image"
            value="<%= user.image %>"
            placeholder="Paste image URL"
            class="w-full bg-zinc-950 border border-zinc-700 border border-zinc-700 text-white rounded-2xl px-5 py-3 outline-none focus:ring-2 focus:ring-blue-500"
          />
        </div>

        <!-- Buttons -->
        <button
          class="bg-gradient-to-r from-violet-600 to-fuchsia-600 hover:opacity-90 text-white py-2 rounded-2xl transition mt-3 font-medium shadow-lg"
        >
          Save Changes
        </button>
      </form>

      <a
        href="/profile"
        class="block text-center bg-zinc-800 border border-zinc-700 text-white hover:bg-violet-500 py-2 rounded-2xl mt-4 transition"
      >
        Back
      </a>
    </div>
  </body>
</html>
