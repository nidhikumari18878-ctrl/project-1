<!DOCTYPE html>
<html lang="en">
<head>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Resume Analyzer - Placement Tracker</title>

  <!-- Tailwind -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Google Font -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <style>
    body{
      font-family: 'Poppins', sans-serif;
    }
  </style>

</head>

<body class="bg-black text-white">

  <div class="flex min-h-screen">

    <!-- Sidebar -->
    <aside class="w-72 bg-zinc border-r border-zinc-800 p-6 hidden md:block">

      <!-- Logo -->
      <div class="flex items-center gap-3 mb-12">

        <div class="w-12 h-12 rounded-2xl bg-gradient-to-r from-violet-600 to-fuchsia-600 flex items-center justify-center text-white font-bold shadow-lg">
          PT
        </div>

        <h1 class="text-lg font-semibold">
          Placement Tracker
        </h1>

      </div>

      <!-- Menu -->
      <nav class="space-y-3">

        <a href="/dashboard"
          class="flex items-center gap-3 px-4 py-3 rounded-2xl bg-gradient-to-r from-violet-600/20 to-fuchsia-600/20 text-violet-400 border border-violet-500/20 transition">
          📊 Dashboard
        </a>

        <a href="/application"
          class="flex items-center gap-3 px-4 py-3 rounded-2xl bg-gradient-to-r from-violet-600/20 to-fuchsia-600/20 text-violet-400 border border-violet-500/20 transition">
          📌 Applications
        </a>

        <a href="/resume"
          class="flex items-center gap-3 px-4 py-3 rounded-2xl bg-gradient-to-r from-violet-600/20 to-fuchsia-600/20 text-violet-400 border border-violet-500/20 ">
          📄 Resume Analyzer
        </a>

        <a href="/opportunities"
          class="flex items-center gap-3 px-4 py-3 rounded-2xl bg-gradient-to-r from-violet-600/20 to-fuchsia-600/20 text-violet-400 border border-violet-500/20 transition">
          🏢 Companies
        </a>

        <a href="/profile"
          class="flex items-center gap-3 px-4 py-3 rounded-2xl bg-gradient-to-r from-violet-600/20 to-fuchsia-600/20 text-violet-400 border border-violet-500/20 transition">
          👤 Profile
        </a>

      </nav>

    </aside>

    <!-- Main -->
    <main class="flex-1 p-8">

      <!-- Header -->
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-5 mb-8">

        <div>

          <h1 class="text-3xl font-bold text-white">
            Resume Analyzer 📄
          </h1>

          <p class="text-gray-400 mt-1">
            Analyze your resume with AI insights
          </p>

        </div>

      </div>

      <!-- Upload Box -->
    <form
  action="/upload-resume"
  method="POST"
  enctype="multipart/form-data"
  class="flex flex-col items-center gap-4"
>

  <input
    type="file"
    accept=".pdf"
    name="resume"
    required
    class="bg-zinc-900 border border-zinc-700 text-white px-4 py-3 rounded-3xl"
  >

  <button
    type="submit"
    class="bg-violet-600 hover:bg-violet-700 text-white px-6 py-3 rounded-2xl"
  >
    Upload Resume
  </button>

</form>
      <!-- Analytics Grid -->
      <div class="grid lg:grid-cols-3 gap-6 mb-8">

        <!-- ATS Score -->
        <div class="bg-zinc-900/80 backdrop-blur-xl border border-zinc-800 rounded-3xl p-8 flex flex-col items-center justify-center">

          <h2 class="text-xl font-semibold mb-6">
            ATS Score
          </h2>

          <!-- Circle -->
          <div class="w-40 h-40 rounded-full border-[14px] border-violet-600 flex items-center justify-center mb-4">

            <div class="text-center">

              <h1 class="text-4xl font-bold text-white">
                <%=resumeData? resumeData.atsScore:0 %>%
              </h1>

              <p class="text-sm text-gray-400 mt-1">
               

<% if(resumeData && resumeData.atsScore >= 80){ %>
Excellent
<% } else if(resumeData && resumeData.atsScore >= 60){ %>
Good
<% } else { %>
Needs Improvement
<% } %>

</p>
              </p>

            </div>

          </div>

          <p class="text-gray-400 text-center">
            Your resume performs well for ATS systems.
          </p>

        </div>

        <!-- Skills Match -->
        <div class="bg-zinc-900/80 backdrop-blur-xl border border-zinc-800 rounded-3xl p-8 ">

          <h2 class="text-xl font-semibold mb-6">
            Skills Match
          </h2>

          <div class="space-y-4">

          <% if(resumeData){ %>

  <% resumeData.skills.forEach(skill=>{ %>

    <div class="flex items-center justify-between bg-green-500/10 border border-green-500/20 px-5 py-4 rounded-2xl">

      <span><%= skill %></span>

      <span class="text-green-600">
        ✓
      </span>

    </div>

  <% }) %>

<% } %>

          </div>

        </div>

        <!-- AI Suggestions -->
        <div class="bg-gradient-to-br from-violet-600 to-fuchsia-600 rounded-3xl p-8 text-white shadow-xl">

          <div class="text-5xl mb-6">
            🤖
          </div>

          <h2 class="text-2xl font-bold mb-4">
            AI Suggestions
          </h2>

          <p class="leading-relaxed text-violet-100 mb-6">

            <% if(resumeData && resumeData.suggestions.length){ %>
<p class="leading-relaxed text-violet-100 mb-6">
  <%= resumeData.suggestions[0] %>
</p>
<% } %>

          </p>

          <div class="space-y-3">
            <% if(resumeData){ %>

  <% resumeData.suggestions.forEach(item=>{ %>

    <div class="bg-black/20 border border-white/10 px-4 py-3 rounded-2xl">
      <%= item %>
    </div>

  <% }) %>

<% } %>
          

          </div>

        </div>

      </div>

      <!-- Missing Skills -->
      <div class="bg-zinc-900/80 backdrop-blur-xl border border-zinc-800 rounded-3xl p-8 ">

        <div class="flex items-center justify-between mb-6">

          <h2 class="text-2xl font-semibold">
            Missing Skills
          </h2>

          <span class="text-sm text-gray-400">
            Recommended for placements
          </span>

        </div>

        <!-- Skills -->
        <div class="flex flex-wrap gap-4">
         <% if(resumeData){ %>

  <% resumeData.missingSkills.forEach(skill=>{ %>

      <div class="bg-red-500/10 text-red-400 border border-red-500/20 px-5 py-3 rounded-2xl">

        <%= skill %>

      </div>

  <% }) %>

<% } %>

        </div>

      </div>

    </main>

  </div>
<script src="/javascripts/script.js"></script>
</body>
</html>