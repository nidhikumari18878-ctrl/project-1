<!DOCTYPE html>
<html lang="en">
<head>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Applications - Placement Tracker</title>

  <!-- Tailwind -->
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/stylesheets/style.css">

  <!-- Font -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/style.css">

</head>

<body class="bg-[#f6f7fb]">

  <div class="flex min-h-screen">

    <!-- Sidebar -->
    <aside class="w-72 bg-white border-r border-gray-100 p-6 hidden md:block">

      <!-- Logo -->
      <div class="flex items-center gap-3 mb-12">

        <div class="w-12 h-12 rounded-2xl bg-violet-600 flex items-center justify-center text-white font-bold">
          PT
        </div>

        <h1 class="font-semibold text-lg">
          Placement Tracker
        </h1>

      </div>

      <!-- Menu -->
      <nav class="space-y-3">

        <a href="/dashboard"
          class="flex items-center gap-3 px-4 py-3 rounded-2xl text-gray-600 hover:bg-gray-50 transition">

          📊 Dashboard

        </a>

        <a href="/application"
          class="flex items-center gap-3 px-4 py-3 rounded-2xl bg-violet-50 text-violet-700 font-medium">

          📌 Applications

        </a>
        <a
            href="/opportunities"
            class="flex items-center gap-3 px-4 py-3 rounded-2xl text-gray-600 hover:bg-gray-50 transition"
          >
            🏢 opportunities
          </a>


        <a href="/resume"
          class="flex items-center gap-3 px-4 py-3 rounded-2xl text-gray-600 hover:bg-gray-50 transition">

          📄 Resume Analyzer

        </a>

      </nav>

    </aside>

    <!-- Main -->
    <main class="flex-1 p-8">

      <!-- Top -->
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-5 mb-8">

        <!-- Heading -->
        <div>

          <h1 class="text-3xl font-bold text-gray-800">
            Applications 📌
          </h1>

          <p class="text-gray-500 mt-1">
            Track and manage all your applications
          </p>

        </div>

        <!-- Actions -->
        <div class="flex items-center gap-4">

          <!-- Search -->
          <div class="bg-white px-4 py-3 rounded-2xl shadow-sm flex items-center gap-3 w-72">

            🔍

            <input
              type="text"
              id="searchInput"
              placeholder="Search..."
              class="outline-none w-full text-sm bg-transparent"
            >

          </div>

          <!-- Button -->
          <button
            id="openModalBtn"
            class="bg-violet-600 hover:bg-violet-700 transition text-white px-6 py-3 rounded-2xl shadow-lg"
          >

            + Add Application

          </button>

        </div>

      </div>

      <!-- Status Cards -->
      <div class="grid md:grid-cols-4 gap-6 mb-8">

        <!-- Card -->
        <div class="bg-white p-6 rounded-3xl shadow-sm">

          <div class="text-3xl mb-4">
            📄
          </div>

          <h2 id="totalApplications" class="text-3xl font-bold text-gray-800">0
            
          </h2>

          <p class="text-gray-500 mt-1">
            Applied
          </p>

        </div>

        <!-- Card -->
        <div class="bg-white p-6 rounded-3xl shadow-sm">

          <div class="text-3xl mb-4">
            💻
          </div>

          <h2 id="totalOA" class="text-3xl font-bold text-gray-800">
            5
          </h2>

          <p class="text-gray-500 mt-1">
            OA Round
          </p>

        </div>

        <!-- Card -->
        <div class="bg-white p-6 rounded-3xl shadow-sm">

          <div class="text-3xl mb-4">
            🎯
          </div>

          <h2 id="totalInterviews" class="text-3xl font-bold text-gray-800">
            0
          </h2>

          <p class="text-gray-500 mt-1">
            Interviews
          </p>

        </div>

        <!-- Card -->
        <div class="bg-white p-6 rounded-3xl shadow-sm">

          <div class="text-3xl mb-4">
            🏆
          </div>

          <h2 id="totalSelected" class="text-3xl font-bold text-gray-800">
            0
          </h2>

          <p class="text-gray-500 mt-1">
            Selected
          </p>

        </div>

      </div>

      <!-- Table -->
      <div class="bg-white rounded-3xl shadow-sm p-6 overflow-x-auto">

        <!-- Header -->
        <div class="flex items-center justify-between mb-6">

          <h2 class="text-xl font-semibold">
            Recent Applications
          </h2>

          <select id="statusFilter" class="border border-gray-200 px-4 py-2 rounded-xl outline-none">

            <option>All Status</option>
            <option>Applied</option>
            <option>Interview</option>
            <option>Selected</option>
            <option>OA Round</option>

          </select>

        </div>

        <!-- Table -->
        <table class="w-full min-w-[700px]">

          <thead>

            <tr class="border-b text-left text-gray-400 text-sm">

              <th class="pb-4">Company</th>
              <th class="pb-4">Role</th>
              <th class="pb-4">Date</th>
              <th class="pb-4">Status</th>
              <th class="pb-4">Package</th>
              <th class="pb-4">Note</th>
              <th class="pb-4">Action</th>

            </tr>

          </thead>

         <tbody id="applicationTableBody" class="text-gray-700">

<% applications.forEach(app => { %>

<tr class="border-b">

  <td class="py-4"><%= app.companyName %></td>

  <td class="py-4"><%= app.role %></td>

  <td class="py-4">
    <%= app.createdAt ?
        new Date(app.createdAt).toLocaleDateString()
        : "-" %>
  </td>

  <td class="py-4">
    <span class="px-3 py-1 rounded-full bg-yellow-100 text-yellow-700">
      <%= app.status %>
    </span>
  </td>

  <td class="py-4">
    <%= app.package || "-" %>
  </td>

  <td class="py-4">
    <%= app.note || "-" %>
  </td>

  <td class="py-4">
    <button class="text-blue-600">
      View
    </button>
  </td>

</tr>

<% }) %>

</tbody>

        </table>

      </div>

    </main>

  </div>

  <!-- Modal -->
  <div
    id="applicationModal"
    class="fixed inset-0 bg-black/40 hidden items-center justify-center p-4"
  >

    <!-- Modal Box -->
    <div class="w-full max-w-2xl bg-white rounded-3xl shadow-2xl p-8 max-h-[90vh] overflow-y-auto">

      <!-- Header -->
      <div class="flex items-center justify-between mb-8">

        <div>

          <h2 class="text-3xl font-bold text-gray-800">
            Add Application
          </h2>

          <p class="text-gray-500 mt-1">
            Add new company application
          </p>

        </div>

        <!-- Close -->
        <button
          id="closeModalBtn"
          class="w-11 h-11 rounded-2xl bg-gray-100 hover:bg-gray-200 transition flex items-center justify-center"
        >
          ✕
        </button>

      </div>

      <!-- Form -->
      <form class="space-y-4" id="applicationForm">

        <!-- Grid -->
        <div class="grid md:grid-cols-2 gap-5">

          <!-- Company -->
          <div>

            <label class="block mb-2 text-sm font-medium text-gray-700">
              Company Name
            </label>

            <input
              type="text"
              placeholder="Infosys"
              class="w-full px-5 py-4 rounded-2xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-violet-500"
            >

          </div>

          <!-- Role -->
          <div>

            <label class="block mb-2 text-sm font-medium text-gray-700">
              Role
            </label>

            <input
              type="text"
              placeholder="Frontend Developer"
              class="w-full px-5 py-4 rounded-2xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-violet-500"
            >

          </div>

        </div>

        <!-- Grid -->
        <div class="grid md:grid-cols-2 gap-5">

          <!-- Package -->
          <div>

            <label class="block mb-2 text-sm font-medium text-gray-700">
              Package
            </label>

            <input
              type="text"
              placeholder="₹6 LPA"
              class="w-full px-5 py-4 rounded-2xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-violet-500"
            >

          </div>

          <!-- Status -->
          <div>

            <label class="block mb-2 text-sm font-medium text-gray-700">
              Status
            </label>

            <select
              class="w-full px-5 py-4 rounded-2xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-violet-500 bg-white"
            >

              <option>Applied</option>
              <option>OA Round</option>
              <option>Interview</option>
              <option>Selected</option>

            </select>

          </div>

        </div>

        <!-- Notes -->
        <div>

          <label class="block mb-2 text-sm font-medium text-gray-700">
            Notes
          </label>

          <textarea
            rows="4"
            placeholder="Add interview notes..."
            class="w-full px-5 py-4 rounded-2xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-violet-500 resize-none"
          ></textarea>

        </div>

        <!-- Buttons -->
        <div class="flex items-center justify-end gap-4 pt-4">

          <button
            type="button"
            id="closeModalBtn2"
            class="px-6 py-3 rounded-2xl border border-gray-200 hover:bg-gray-50 transition"
          >
            Cancel
          </button>

          <button
            type="submit"
            class="bg-violet-600 hover:bg-violet-700 transition text-white px-8 py-3 rounded-2xl shadow-lg"
          >
            Add
          </button>

        </div>

      </form>

    </div>

  </div>
<script src="/javascripts/script.js"></script>


</body>
</html>